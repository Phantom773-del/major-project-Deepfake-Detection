# PHANTOM PHOENIX Backend — environment template.
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.
# All values are overridable via environment variables at runtime.

# Application
APP_ENV=development
APP_NAME=PHANTOM PHOENIX Backend
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Database (dev defaults match docker-compose.yml)
DATABASE_URL=postgresql+psycopg://phantom:phantom@localhost:5432/phantom

# Auth (reserved for authentication milestone — change in any real environment)
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Storage
STORAGE_DIR=./storage
MEDIA_STORAGE_ROOT=./storage/media
REPORT_DIR=./reports
# Maximum accepted upload size (MB). Server-side detection is authoritative;
# video ingestion is not supported until a real video pipeline exists.
MAX_UPLOAD_SIZE_MB=50

# HTTP / CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
